# /etc/sl-solo/env  (chmod 600: it holds the miners' login token)
# the SASEUL node's run directory (mining_job is read, mining_result is written; a Docker node: the host side of its run volume)
SL_RUN=/var/saseul-run
# TCP port for ffgs (open it in the firewall only for your rigs)
SL_PORT=19310
# login token: ffgs --pass <token>; empty = no login check. Use a long random string, e.g. `openssl rand -hex 16`
SL_TOKEN=CHANGE_ME
# share difficulty (hashrate monitoring only; a share that meets the network difficulty is sent to the node as a block).
# 1e11 = about one share every 20 s at 5 GH/s
SL_SHARE_DIFF=100000000000
# payout addresses, one 44-hex SASEUL address per line; the proxy moves to the next one at every new block
SL_ADDRESSES=/etc/sl-solo/addresses.txt
# rotation position, share and block counters
SL_STATE=/var/lib/sl-solo/state.json
# public node used to check that your node is in sync (jobs are served only then)
SL_PUBLIC=http://main.saseul.net/info
# 40 = solo nonce layout (ffgs >= 0.2.0 mines it ~1-2% faster); 16-hex nonces are accepted as well
SL_NONCE_LEN=40
